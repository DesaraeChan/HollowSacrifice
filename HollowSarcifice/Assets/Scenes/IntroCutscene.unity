  m_Script: {fileID: 11500000, guid: d08f13523ab37544e934c6dba1268be2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  characterAnimator: {fileID: 0}
  nextSceneName: Home
  textComponent: {fileID: 1773173846}
  lines:
  - 'Acid rain pours from the sky.   '
  - 'Your home Zaetia, has recently been able to leave their underground settlement
    and return to the surface. '
  - 'Solzae is the mineral that made this possible. It protects everyone from the
    acid rain that pours incessantly.  '
  - "It lights the darkness, fertilizes the land, and adds a warm flavour to any
    dish it\u2019s sprinkled into."
  - 'You were recently gifted a shop by your father who has left to fight in the
    ongoing war against the Plab nation.   '
  - 'It is up to you to provide for your father and yourself in times of war. '
  slideshow:
  - {fileID: 346260117}
  - {fileID: 1310944689}
  - {fileID: 951366712}
  cutscene: {fileID: 1533724593}
  textSpeed: 0.05
