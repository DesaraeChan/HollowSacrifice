  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9ba6f5bf1e942ac4ebaf189dcbd20cb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCCloseup
  playerTag: Player
  interactKey: 101
  dialogueRoot: {fileID: 727658078}
  textBox: {fileID: 510881885}
  charDelay: 0.03
  introLines:
  - 'I think you know how it is out here. Cold. Wet. Acidic. '
  - "Do you have anything to spare? I\u2019d appreciate anything really, just trying
    to get by like yourself.\n"
  - "Why did I ask you over here?  \n"
  - 'Haha, well you look like a kind person. You also look like you might have something
    on you to help a guy out.


'
  choicePanel: {fileID: 1411882432}
  choiceAButton: {fileID: 1303074583}
  choiceBButton: {fileID: 894055197}
  choiceAText: {fileID: 1197243062}
  choiceBText: {fileID: 1569012712}
  choiceALabel: Here take some change.
  choiceBLabel: Here, have some Solzae.
  afterChoiceA:
  - 'Ah thank you! I knew you looked like a kind soul.

'
  - I could buy a bowl of soup using this. Just like me mum used to make.
  afterChoiceB:
  - "Ah thank you, like I said anything helps really when you\u2019re out here."
  - "I\u2019ll use this, and won\u2019t waste it AHARHA!"
  clickSkipsWhileTyping: 1
  hasChoices: 1
  typingSoundClips:
  - {fileID: 8300000, guid: 2a4ddc9737ac675439b54ed236c54ef7, type: 3}
  - {fileID: 8300000, guid: b086c408203cb68428f13fba6b284d6f, type: 3}
